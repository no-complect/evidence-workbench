# Local-only defaults. scripts/dev.sh creates .env only when it does not exist.
# Compose fixes local auth/database/API/storage routing; changing those entries
# here does not turn Compose into a production deployment. See docs/DEPLOYMENT.md.
# Host-run Python loads root .env; Next host development needs APP_ENV explicitly
# and its public auth settings in apps/web/.env.local (or its process environment).
APP_ENV=local
AUTH_MODE=demo
DATABASE_URL=postgresql://workbench:workbench@localhost:55432/workbench
API_SHARED_SECRET=local-demo-only-not-for-production
API_URL=http://localhost:8000
STORAGE_PATH=.runtime/objects
STORAGE_BACKEND=local
CREDENTIAL_STORE_PATH=.runtime/credentials
# Optional local Compose host-port overrides; container routing stays unchanged.
WORKBENCH_WEB_PORT=3000
WORKBENCH_API_PORT=8000
WORKBENCH_DB_PORT=55432
# Worker coordination (API and both workers use the same settings).
LEASE_SECONDS=30
POLL_SECONDS=0.5
# Live calls are opt-in, never used by demo startup/evaluation.
LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# Optional initial selection if only Anthropic is configured; otherwise choose in the UI.
ANTHROPIC_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional estimates from your provider contract. Model prices apply to OPENAI_MODEL only.
# Without prices, dollar totals are unavailable; token/tool/time limits still apply.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# Optional USD per million embedding tokens; snapshots per ingestion attempt. Not a spending cap.
EMBEDDING_USD_PER_MILLION=
WEB_SEARCH_USD_PER_CALL=
TAVILY_API_KEY=
# Required when AUTH_MODE=supabase; URL must use HTTPS, except local loopback HTTP.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required when STORAGE_BACKEND=supabase. Keep server-side; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=research-sources
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_MODE=demo
# Production additionally requires an explicit direct/session PostgreSQL
# DATABASE_URL with sslmode=require/verify-ca/verify-full, a random shared secret
# (32+ characters), Supabase auth/private storage and rebuilt public web settings.
# Optional MCP/deployment-check session; never commit a populated value.
# verify-deployment.py ignores .env: explicitly provide this in the process
# environment only when using its --authenticated flag. URLs use CLI arguments.
WORKBENCH_ACCESS_TOKEN=
