# Local-only defaults. Production must use AUTH_MODE=supabase and APP_ENV=production.
APP_ENV=local
AUTH_MODE=demo
DATABASE_URL=postgresql://workbench:workbench@localhost:55432/workbench
API_SHARED_SECRET=local-demo-only-not-for-production
API_URL=http://localhost:8000
STORAGE_PATH=.runtime/objects
STORAGE_BACKEND=local
# Live calls are opt-in, never used by demo startup/evaluation.
LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# Optional initial selection if only Anthropic is configured; otherwise choose in the UI.
ANTHROPIC_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional estimates from your provider contract. Model prices apply to OPENAI_MODEL only.
# Without prices, dollar totals are unavailable; token/tool/time limits still apply.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=
WEB_SEARCH_USD_PER_CALL=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=research-sources
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_MODE=demo
